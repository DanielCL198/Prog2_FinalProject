<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="503.0" prefWidth="514.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaFx.Bank.BankController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Pane prefHeight="481.0" prefWidth="474.0">
        <children>
            <PasswordField fx:id="Password_create" layoutX="30.0" layoutY="205.0" />
            <Label layoutX="63.0" layoutY="54.0" text="Create Account" />
            <Label layoutX="355.0" layoutY="54.0" text="Log in" />
            <TextField fx:id="FirstName_Create" layoutX="30.0" layoutY="112.0" prefHeight="25.0" prefWidth="149.0" />
            <TextField fx:id="LastName_Create" layoutX="30.0" layoutY="156.0" />
         <PasswordField fx:id="Password_Login" layoutX="297.0" layoutY="205.0" />
         <TextField fx:id="FirstName_Login" layoutX="296.0" layoutY="112.0" prefHeight="25.0" prefWidth="149.0" />
         <TextField fx:id="LastName_Login" layoutX="297.0" layoutY="156.0" />
         <Button layoutX="79.0" layoutY="297.0" mnemonicParsing="false" onAction="#handleCreate" text="Create" />
         <Button layoutX="344.0" layoutY="262.0" mnemonicParsing="false" onAction="#handleLogin" text="Login" />
         <Label layoutX="208.0" layoutY="116.0" text="First Name" />
         <Label layoutX="208.0" layoutY="160.0" text="Last Name" />
         <Label layoutX="209.0" layoutY="209.0" text="Password" />
         <Label graphicTextGap="5.0" layoutX="127.0" layoutY="1.0" prefHeight="27.0" prefWidth="221.0" text="E-Banking Application" underline="true">
            <font>
               <Font name="Arial Black" size="18.0" />
            </font>
         </Label>
            <ChoiceBox fx:id="clientTypeChoice" layoutX="49.0" layoutY="250.0" prefHeight="25.0" prefWidth="111.0" />
            <Label fx:id="createErrorLabel" layoutX="72.0" layoutY="346.0" text="Invalid Input" visible="false"/>
            <Label fx:id="loginErrorLabel" layoutX="338.0" layoutY="314.0" text="Invalid Input" visible="false"/>
        </children>
    </Pane>
</VBox>
