CLASS Accounts.Client (ABSTRACT)
    ATTRIBUTES:
        clientId = String
        name = String
        accounts = List of Accounts.Account

    METHOD addAccount(account)
        ADD account TO accounts

    METHOD getAccounts()
        RETURN accounts

    METHOD hasChequeingAccount()
        FOR each acc IN accounts
            IF acc IS Accounts.ChequeingAccount
            THEN RETURN true
        RETURN false

    METHOD toString()
        RETURN clientId + name

CLASS Clients.StandardClient EXTENDS Accounts.Client IMPLEMENTS Clients.Maintainable
    METHOD applyMonthlyFee()
        FOR each acc IN accounts
            acc.balance = acc.balance - 10

CLASS Clients.StudentClient EXTENDS Clients.StandardClient

CLASS Clients.IndividualClient EXTENDS Clients.StandardClient
 // inherits fee behavior

CLASS Clients.PremiumClient EXTENDS Accounts.Client

CLASS Clients.CorporateClient EXTENDS Clients.PremiumClient IMPLEMENTS Clients.Maintainable

CLASS Clients.VIPClient EXTENDS Clients.PremiumClient

CLASS Accounts.Account (ABSTRACT)
    ATTRIBUTES:
        accountNumber = String
        balance = double
        owner = Accounts.Client

    METHOD getBalance()
        RETURN balance
    METHOD deposit(amount)
        balance = balance + amount

    METHOD deposit(amount, description)
        balance = balance + amount
    METHOD withdraw(amount)
        IF amount > balance
        THEN THROW Accounts.InsufficientFundsException
        ELSE
            balance = balance - amount

    METHOD transfer(targetAccount, amount)
        IF amount > balance
        THEN THROW Accounts.InsufficientFundsException
        ELSE
            balance = balance - amount
            targetAccount.deposit(amount)

CLASS Accounts.ChequeingAccount EXTENDS Accounts.Account

    METHOD addTransaction(transaction)
        // store transaction 

CLASS Accounts.SavingAccount EXTENDS Accounts.Account IMPLEMENTS Accounts.InterestBearing

    ATTRIBUTE:
        interestRate = 0.02

    METHOD applyInterest()
        rate = interestRate
        IF owner IS Clients.VIPClient
        THEN rate = rate + 0.01
        balance = balance + (balance * rate)

CLASS Accounts.InvestmentAccount EXTENDS Accounts.Account IMPLEMENTS Accounts.InterestBearing

    ATTRIBUTE:
        interestRate = 0.05

    METHOD applyInterest()
        rate = interestRate
        IF owner IS Clients.VIPClient
        THEN rate = rate + 0.01
        balance = balance + (balance * rate)

    OVERRIDE
    METHOD withdraw(amount)
        THROW Exception

    METHOD chequeingTransfer(amount)
        IF owner.hasChequeingAccount() IS FALSE
        THEN THROW Accounts.MissingChequeingAccountException
        IF amount > balance
        THEN THROW Accounts.InsufficientFundsException
        IF account is less than 1 year old
        THEN THROW Accounts.InvestmentLockException

        balance = balance - amount
        TRANSFER amount TO owner's Accounts.ChequeingAccount

CLASS Accounts.Transaction

    ATTRIBUTES:
        transactionId = String
        amount = double
        type = String

    METHOD toString()
        RETURN transactionId + amount + type

INTERFACE Accounts.InterestBearing
    METHOD applyInterest()

